/outputs/

# Large medical imaging data should stay outside version control.
# (Exceptions: test fixtures under tests/ are tracked intentionally.)
*.nii
*.nii.gz
*.dcm
*.ima
*.mha
*.mhd
*.nrrd
!tests/**/*.nii
!tests/**/*.nii.gz

# Uploaded ZIPs
*.zip
!tests/**/*.zip

