# Local editor and operating-system files
.DS_Store
.idea/
.vscode/
*.log
*.tmp

# Python environments, caches, and build products
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Frontend test output
node_modules/
playwright-report/
test-results/

# Local credentials
.env
.env.*
!.env.example
*.key
*.pem
*.token

# Uploaded and extracted submissions
/submissions/incoming/*
!/submissions/incoming/.gitkeep
/submissions/extracted/*
!/submissions/extracted/.gitkeep
/submissions/validated/*
!/submissions/validated/.gitkeep

# Generated pipeline output
/data/outputs/*
!/data/outputs/.gitkeep
!/data/outputs/execution/
!/data/outputs/manifests/
!/data/outputs/validation/
/data/outputs/execution/*
!/data/outputs/execution/.gitkeep
/data/outputs/manifests/*
!/data/outputs/manifests/.gitkeep
/data/outputs/validation/*
!/data/outputs/validation/.gitkeep
/outputs/
/release/
/tmp/

# Organiser-managed configuration, packages, references, and private assets
/data/configuration_manager/
/data/scoring/
/data/reference_data/*
!/data/reference_data/.gitkeep
/private_scoring_assets/
/data/hidden/
/data/organizer_data/
/data/organiser_data/
/data/ground_truth/
/data/ground-truth/
/data/challenge_data/
/data/masks/
/data/measured_st/
/data/scoring_results/

# Medical images and uploaded archives are local unless tracked as test fixtures
*.nii
*.nii.gz
*.dcm
*.dicom
*.ima
*.mha
*.mhd
*.nrrd
*.zip
!tests/**/*.nii
!tests/**/*.nii.gz
!tests/**/*.zip

# Local preview and audit files
/.codex-ui-audit/
/docs-preview.png
/video-preview.png
